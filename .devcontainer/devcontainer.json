{
  "name": "dev-pod-sh host",
  "image": "mcr.microsoft.com/vscode/devcontainers/universal:linux",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "mounts": [
    {"source": "m2-cache", "target": "/home/codespace/.m2", "type": "volume"},
    {"source": "npm-cache", "target": "/home/codespace/.npm", "type": "volume"},
    {"source": "pip-cache", "target": "/home/codespace/.cache/pip", "type": "volume"}
  ]
}